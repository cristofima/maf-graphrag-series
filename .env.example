# Azure OpenAI (required)
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_ROUTER_DEPLOYMENT=router-deployment-name

# Azure OpenAI (optional overrides)
AZURE_OPENAI_API_VERSION=2024-11-20
AZURE_OPENAI_ROUTER_ENDPOINT=https://your-router-resource.openai.azure.com/
AZURE_OPENAI_ROUTER_SUBSET=default

# Evaluation (optional)
AZURE_OPENAI_EVAL_API_VERSION=2025-04-01-preview
AZURE_OPENAI_EVAL_CHAT_DEPLOYMENT=gpt-4o
AZURE_AI_PROJECT=https://your-project.services.ai.azure.com/api/projects/your-project
ENTITIES_PARQUET_PATH=output/create_final_entities.parquet
RELATIONSHIPS_PARQUET_PATH=output/create_final_relationships.parquet

# Monitoring (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_TRACING_ENDPOINT=http://localhost:4317

# Agent + Workflow MCP client (optional)
MCP_SERVER_URL=http://127.0.0.1:8011/mcp

# MCP Server (optional)
MCP_HOST=127.0.0.1
MCP_PORT=8011
GRAPHRAG_ROOT=.
MCP_CORS_ORIGINS=http://127.0.0.1:8011

# DevUI (optional)
DEVUI_HOST=127.0.0.1
DEVUI_PORT=8080
DEVUI_AUTO_OPEN=true
DEVUI_MODE=developer
DEVUI_AUTH_ENABLED=false
DEVUI_AUTH_TOKEN=

# Workflow step visibility (optional)
WORKFLOW_STEP_LOGS=false

# Logging rotation (optional)
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=5
